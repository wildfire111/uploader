# neon pooled connection string (the host has -pooler in it)
DATABASE_URL=

# random string for session cookies: openssl rand -base64 32
BETTER_AUTH_SECRET=

# base url for magic links. set for local dev and production, leave unset on previews
BETTER_AUTH_URL=

# gmail account that sends the login emails
GMAIL_USER=
GMAIL_APP_PASSWORD=

# encrypts the moxfield tokens and user agent stored in the database:
# openssl rand -base64 32 (use a different one for dev and prod)
MOXFIELD_TOKEN_ENCRYPTION_KEY=

# ms to wait before each moxfield request, defaults to 1000
MOXFIELD_DELAY_MS=

